---
import "../styles/portfolio.css";
import { projects } from "../data/projects";
import { contact } from "../data/contact";
import { profile } from "../data/profile";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={
        profile.introduction || "Projects, software, and a pocket arcade."
      }
    />
    <meta name="theme-color" content="#11151e" />
    <title>{profile.name ? `${profile.name} — Projects & play` : 'Portfolio — Projects & play'}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#projects">
      Skip to projects
    </a>
    <div class="site">
      <header id="top">
        <a class="brand" href="#top">
          <span class="brand-icon" aria-hidden="true">
            ⌘
          </span>{" "}
          {profile.name || "Portfolio"}
        </a>
        <nav aria-label="Main navigation">
          <a href="#projects">Projects</a>
          <a href="#arcade">Play</a>
          <button data-connect>
            Contact <span>↗</span>
          </button>
        </nav>
      </header>
      <main>
        <section class="intro" aria-labelledby="title">
          <div class="intro-copy">
            <span class="eyebrow">
              <span></span> PROJECTS / SOFTWARE / A LITTLE FUN
            </span>
            {profile.name ? (
              <h1 class="personal-heading">
                Hi, I'm <span class="built">{profile.name}</span>
                <span class="period">.</span>
              </h1>
            ) : (
              <h1>
                A few things
                <br />
                I've{" "}
                <span class="built">
                  built
                  <svg viewBox="0 0 270 22" aria-hidden="true">
                    <path d="M4 14Q125 0 263 10M17 20Q133 9 239 17" />
                  </svg>
                </span>
                <span class="period">.</span>
              </h1>
            )}
            {profile.introduction ? (
              <p>{profile.introduction}</p>
            ) : (
              <p>
                Projects live here.
                <br />
                You're welcome to stay for a game.
              </p>
            )}
            <a class="work-link" href="#projects">
              See the projects <span>↗</span>
            </a>
            <div class="intro-footnote">
              <span class="tiny-arrow" aria-hidden="true">
                ↳
              </span>{" "}
              Or beat your high score over there.
            </div>
          </div>
          <div class="arcade-wrap" id="arcade">
            <div class="cartridge-rack" role="group" aria-label="Choose a game">
              {["snake", "pong", "breakout"].map((game, index) => (
                <button
                  class="cartridge"
                  data-game={game}
                  aria-pressed={index === 0}
                >
                  <span class="cartridge-ridges" aria-hidden="true"></span>
                  <span class="cartridge-label">
                    <span aria-hidden="true">{["⌁", "Ⅱ", "▦"][index]}</span>
                    <b>{game}</b>
                    <small>0{index + 1}</small>
                  </span>
                </button>
              ))}
            </div>
            <p class="cartridge-hint">
              Pick a cartridge. Switching starts a new game.
            </p>
            <div class="console">
              <div class="console-top">
                <span class="console-brand">
                  <span aria-hidden="true">▥</span>{" "}
                  <span id="console-game-name">SNAKE</span>
                </span>
                <span class="console-edition">POCKET EDITION / 01</span>
                <span class="power-light" aria-hidden="true"></span>
              </div>
              <div class="screen-frame">
                <div class="scoreboard">
                  <span>
                    SCORE <b id="score">00</b>
                  </span>
                  <span id="lives" hidden>
                    LIVES <b id="lives-value">3</b>
                  </span>
                  <span>
                    BEST <b id="best">00</b>
                  </span>
                </div>
                <div
                  class="board"
                  id="board"
                  tabindex="0"
                  role="group"
                  aria-label="Snake game. Use arrow keys or WASD to move, space to pause."
                  aria-describedby="game-help"
                >
                  <canvas
                    width="400"
                    height="400"
                    id="snake-canvas"
                    aria-label="Snake game board"
                  ></canvas>
                  <div class="game-overlay" id="game-overlay">
                    <span class="game-symbol" aria-hidden="true">
                      ⌁
                    </span>
                    <h2 id="game-title">One quick game?</h2>
                    <p id="game-message">The original time well wasted.</p>
                    <button id="start-game">
                      Play Snake <span>↗</span>
                    </button>
                  </div>
                </div>
                <div class="screen-bottom">
                  <span id="game-status" role="status" aria-live="polite">
                    READY WHEN YOU ARE
                  </span>
                  <span aria-hidden="true">● ● ●</span>
                </div>
              </div>
              <div class="console-controls">
                <div
                  class="dpad"
                  role="group"
                  aria-label="Game direction controls"
                >
                  <button data-direction="up" aria-label="Move up">
                    ↑
                  </button>
                  <button data-direction="left" aria-label="Move left">
                    ←
                  </button>
                  <span aria-hidden="true"></span>
                  <button data-direction="right" aria-label="Move right">
                    →
                  </button>
                  <button data-direction="down" aria-label="Move down">
                    ↓
                  </button>
                </div>
                <div class="game-options">
                  <button id="pause-game" disabled>
                    Pause <span>Ⅱ</span>
                  </button>
                  <button id="reset-game">
                    Reset <span>↺</span>
                  </button>
                </div>
                <div class="speaker" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
              </div>
              <div class="console-bottom">
                <span id="game-help">
                  ARROWS / WASD TO MOVE · SPACE TO PAUSE
                </span>
                <span>✳</span>
              </div>
            </div>
            <div class="arcade-settings">
              <div class="shell-picker" role="group" aria-label="Console color">
                <span>FINISH</span>
                {["lavender", "sage", "sand"].map((color) => (
                  <button
                    data-shell={color}
                    aria-label={`${color} console`}
                    aria-pressed={color === "lavender"}
                    title={color}
                  ></button>
                ))}
              </div>
              <label class="difficulty-label" for="difficulty">
                SPEED{" "}
                <select id="difficulty">
                  <option value="easy">Easy</option>
                  <option value="normal" selected>
                    Normal
                  </option>
                  <option value="fast">Fast</option>
                </select>
              </label>
            </div>
            <div class="arcade-extras">
              <button id="sound-toggle" aria-pressed="false">
                Sound off <span aria-hidden="true">♪</span>
              </button>
              <div class="companion-wrap">
                <span id="companion-caption">Ready to watch.</span>
                <button
                  class="companion"
                  id="companion"
                  aria-label="Say hello to the pixel companion"
                  data-mood="idle"
                >
                  <svg
                    viewBox="0 0 32 32"
                    shape-rendering="crispEdges"
                    aria-hidden="true"
                  >
                    <path
                      fill="#82799e"
                      d="M6 8h20v3h3v14h-3v3H6v-3H3V11h3zM7 28h5v4H7zm13 0h5v4h-5z"
                    />
                    <path fill="#c6b9f3" d="M6 8h20v15H6zM14 2h4v6h-4z" />
                    <path fill="#e8e1f8" d="M14 0h4v3h-4z" />
                    <g class="companion-eyes" fill="#262335">
                      <path d="M9 13h4v5H9zm10 0h4v5h-4z" />
                    </g>
                    <path
                      class="companion-mouth"
                      fill="#504565"
                      d="M13 21h6v2h-6z"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>
        <section id="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <span class="eyebrow">THE PROJECTS</span>
              <h2 id="projects-title">
                On the workbench<span>.</span>
              </h2>
            </div>
            <span class="content-note">Featured: Atlas mobile app</span>
          </div>
          <div class="projects">
            {projects.map((project, index) => (
              <details
                class:list={[
                  "project",
                  { "project-featured": project.featured },
                ]}
                data-project-index={index}
              >
                <summary>
                  <span class="project-number">0{index + 1}</span>
                  <span
                    class:list={["project-thumb", { "has-logo": project.logo }]}
                    aria-hidden="true"
                  >
                    {project.logo ? (
                      <img src={project.logo} alt="" width="512" height="512" />
                    ) : (
                      project.icon || ["⌘", "{ }", "↗"][index % 3]
                    )}
                  </span>
                  <span class="project-name">
                    {project.featured && (
                      <span class="featured-label">FEATURED PROJECT</span>
                    )}
                    <span>{project.title}</span>
                    <small>
                      {project.placeholder
                        ? "Details to be added"
                        : project.role || project.tags.join(" / ")}
                    </small>
                    {project.featured && (
                      <span class="featured-description">
                        {project.description}
                      </span>
                    )}
                  </span>
                  <span class="project-type">
                    {project.placeholder ? "Placeholder" : "View details"}
                  </span>
                  <span class="project-expand" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="project-body">
                  <div class="preview-window">
                    <div class="preview-chrome">
                      <span aria-hidden="true">● ● ●</span>
                      <span>{project.title}</span>
                      <span aria-hidden="true">↗</span>
                    </div>
                    {project.image ? (
                      <img
                        src={project.image}
                        alt={project.imageAlt || project.title}
                        width="800"
                        height="500"
                        loading="lazy"
                      />
                    ) : (
                      <div class="preview-empty">
                        <span class="preview-glyph" aria-hidden="true">
                          {project.icon || ["⌘", "{ }", "↗"][index % 3]}
                        </span>
                        <span>
                          {project.featured
                            ? "Mobile app screenshots coming soon"
                            : "Project preview to be added"}
                        </span>
                      </div>
                    )}
                  </div>
                  <div class="project-description">
                    <span class="eyebrow">
                      {project.placeholder
                        ? "PLACEHOLDER"
                        : "ABOUT THE PROJECT"}
                    </span>
                    <p>{project.description}</p>
                    {project.tags.length > 0 && (
                      <ul class="project-tags">
                        {project.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                    <div class="project-links">
                      {project.source && (
                        <a href={project.source}>Source code ↗</a>
                      )}
                      {project.demo && <a href={project.demo}>Live demo ↗</a>}
                    </div>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>
      </main>
      <footer>
        <a class="brand" href="#top">
          <span class="brand-icon" aria-hidden="true">
            ⌘
          </span>{" "}
          Portfolio
        </a>
        <span>Built with Astro. Played with arrow keys.</span>
        <button data-connect>Get in touch ↗</button>
      </footer>
    </div>
    <dialog id="contact-dialog" aria-labelledby="contact-title">
      <div class="dialog-top">
        <span>CONTACT</span>
        <button id="close-contact" aria-label="Close contact panel">
          ✕
        </button>
      </div>
      <h2 id="contact-title">Get in touch.</h2>
      {contact.length ? (
        <div class="contact-links">
          {contact.map((link) =>
            link.copy ? (
              <div class="contact-copy-row">
                <span class="contact-identity">
                  <strong>{link.label}</strong>
                  <span>{link.value}</span>
                </span>
                <button
                  data-copy-contact={link.value}
                  aria-label={`Copy ${link.label} username`}
                >
                  Copy
                </button>
              </div>
            ) : (
              <a href={link.url}>
                <span class="contact-identity">
                  <strong>{link.label}</strong>
                  <span>{link.value}</span>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            ),
          )}
          <span
            id="contact-copy-status"
            role="status"
            aria-live="polite"
          ></span>
        </div>
      ) : (
        <p>Contact links haven’t been added yet.</p>
      )}
    </dialog>
    <dialog id="project-inspector" aria-labelledby="inspector-title">
      <div class="inspector-bar">
        <span>PROJECT INSPECTOR</span>
        <button id="close-inspector" aria-label="Close project inspector">
          ✕
        </button>
      </div>
      <div id="inspector-content"></div>
      <div class="inspector-navigation">
        <button id="previous-project">← Previous</button>
        <span id="inspector-position"></span>
        <button id="next-project">Next →</button>
      </div>
    </dialog>
    {projects.map((project, index) => (
      <template id={`project-template-${index}`}>
        <div class="inspector-heading">
          <span class="eyebrow">
            {project.placeholder
              ? "PLACEHOLDER PROJECT"
              : project.featured
                ? "FEATURED PROJECT"
                : "PROJECT DETAILS"}
          </span>
          <h2 id="inspector-title">{project.title}</h2>
          <p>{project.description}</p>
          {project.role && (
            <div class="project-role">
              <span>MY ROLE</span>
              <strong>{project.role}</strong>
            </div>
          )}
          {project.source && (
            <a class="inspector-source" href={project.source}>
              View on GitHub ↗
            </a>
          )}
        </div>
        <div
          class:list={[
            "inspector-gallery",
            { "has-screenshots": project.screenshots?.length },
          ]}
        >
          <div class="screenshot-track">
            {(project.screenshots?.length
              ? project.screenshots
              : project.image
                ? [
                    {
                      src: project.image,
                      alt: project.imageAlt || project.title,
                    },
                  ]
                : []
            ).map((shot, shotIndex) => (
              <figure data-screenshot={shotIndex}>
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width={"width" in shot ? shot.width : 800}
                  height={"height" in shot ? shot.height : 500}
                  loading="lazy"
                />
                <figcaption>
                  <span>{shot.alt}</span>
                  <a href={shot.src} target="_blank" rel="noopener noreferrer">
                    Open full size ↗
                  </a>
                </figcaption>
              </figure>
            ))}
          </div>
          {project.screenshots && project.screenshots.length > 1 && (
            <div class="gallery-controls" hidden>
              <div class="gallery-navigation">
                <button data-gallery-prev aria-label="Previous screenshot">
                  ←
                </button>
                <span data-gallery-count aria-live="polite">
                  1 / {project.screenshots.length}
                </span>
                <button data-gallery-next aria-label="Next screenshot">
                  →
                </button>
              </div>
              <div
                class="gallery-thumbnails"
                role="group"
                aria-label="Choose a screenshot"
              >
                {project.screenshots.map((shot, shotIndex) => (
                  <button
                    data-gallery-index={shotIndex}
                    aria-label={`Screenshot ${shotIndex + 1}: ${shot.alt}`}
                    aria-pressed={shotIndex === 0}
                  >
                    <img
                      src={shot.src}
                      alt=""
                      width={shot.width || 406}
                      height={shot.height || 905}
                      loading="lazy"
                    />
                  </button>
                ))}
              </div>
            </div>
          )}
          {!project.image && !project.screenshots?.length && (
            <div class="inspector-empty">
              <span aria-hidden="true">
                {project.icon || ["⌘", "{ }", "↗"][index % 3]}
              </span>
              <p>
                {project.featured
                  ? "Mobile app screenshots coming soon."
                  : "Screenshots haven’t been added yet."}
              </p>
            </div>
          )}
        </div>
        <div class="inspector-description">
          <p>
            {project.details ||
              (project.placeholder
                ? "This is a placeholder. The project explanation, screenshots, and links will appear here when added."
                : project.description)}
          </p>
          {project.highlights && (
            <section class="project-highlights" aria-label="App features">
              {project.highlights.map((item) => (
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              ))}
            </section>
          )}
          {project.tags.length > 0 && (
            <ul class="project-tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
          <div class="project-links">
            {project.source && <a href={project.source}>Source code ↗</a>}
            {project.demo && <a href={project.demo}>Live demo ↗</a>}
          </div>
        </div>
      </template>
    ))}
    <script src="../scripts/portfolio.ts"></script>
  </body>
</html>
